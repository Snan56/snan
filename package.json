{
  "name": "parcours-android",
  "version": "1.0.0",
  "private": true,
  "description": "Applis Android et iPhone de Parcours (Capacitor)",
  "scripts": {
    "build:www": "node build-www.mjs",
    "sync": "npm run build:www && npx cap sync",
    "ios": "npm run build:www && npx cap sync ios && npx cap open ios",
    "ios:gratuit": "node scripts/ios-gratuit.mjs && npm run ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-health": "^8.11.14",
    "maplibre-gl": "^4.7.1",
    "three": "^0.160.0"
  }
}
